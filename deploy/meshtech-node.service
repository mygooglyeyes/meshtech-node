[Unit]
Description=meshtech-node - listen-only mesh listener + scope feed
After=network.target cleanmodem.service
Wants=cleanmodem.service

[Service]
Type=simple
# RUNBOOK NOTE: set User= to Brett's box account at deploy time
# (machine-specific details are never committed).
User=CHANGE_ME
WorkingDirectory=/opt/meshtech-node
ExecStart=/opt/meshtech-node/.venv/bin/python -m meshtech_node --config /opt/meshtech-node/config.json
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
